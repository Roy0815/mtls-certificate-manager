<%- include('partials/header', { title: title }) %>

<div class="security-step">
  <div class="security-step-head">
    <span class="icon-chip"><%- include('partials/icon', { name: typeof icon !== 'undefined' ? icon : 'lock' }) %></span>
    <div>
      <h1><%= title %></h1>
      <p><%= description %></p>
    </div>
  </div>
  <div class="security-step-body">
    <div class="context-hint">
      <%- include('partials/icon', { name: 'key-round' }) %>
      <span>Dein Passwort entschlüsselt den CA-Schlüssel – nur für diese eine Aktion, danach wird er wieder aus dem Speicher entfernt. Deshalb fragen wir hier erneut.</span>
    </div>
    <% if (error) { %>
      <div class="alert alert-error"><%- include('partials/icon', { name: 'alert-circle' }) %><span><%= error %></span></div>
    <% } %>
    <form method="POST" action="<%= action %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Admin-Passwort
        <input type="password" name="password" required autofocus autocomplete="current-password">
      </label>
      <div class="form-actions">
        <button type="submit"><%- include('partials/icon', { name: typeof icon !== 'undefined' ? icon : 'lock' }) %><%= submitLabel %></button>
        <a href="/" class="button-secondary">Abbrechen</a>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
