<%- include('partials/header', { title: 'Zertifikat heruntergeladen' }) %>
<h1>Zertifikat zum Download bereit</h1>
<p>Die .p12-Datei für <strong><%= user.name %></strong> wurde erstellt.</p>

<div class="result-box">
  <div class="result-field">
    <label>Export-Passwort für die .p12-Datei</label>
    <div class="copy-row">
      <input type="text" id="export-password" value="<%= exportPassword %>" readonly>
      <button type="button" data-copy-target="#export-password">Kopieren</button>
    </div>
  </div>
  <p class="hint">
    Datei und Passwort bitte über getrennte Kanäle an den Empfänger übermitteln.
    Der Download-Link ist nur einmalig gültig und läuft nach kurzer Zeit ab.
  </p>
  <a href="<%= downloadPath %>" class="button">Datei herunterladen</a>
</div>

<p><a href="/">Zurück zum Dashboard</a></p>

<%- include('partials/footer') %>
