<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · mTLS Certificate Manager</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="brand">mTLS Certificate Manager</a>
      <% if (typeof username !== 'undefined' && username) { %>
        <form method="POST" action="/logout" class="logout-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <span class="user-badge"><%= username %></span>
          <button type="submit" class="link-button">Abmelden</button>
        </form>
      <% } %>
    </div>
  </header>
  <main class="container">
    <% if (typeof successMessages !== 'undefined') { successMessages.forEach(function(msg) { %>
      <div class="flash flash-success"><%= msg %></div>
    <% }) } %>
    <% if (typeof errorMessages !== 'undefined') { errorMessages.forEach(function(msg) { %>
      <div class="flash flash-error"><%= msg %></div>
    <% }) } %>
