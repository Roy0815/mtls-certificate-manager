<%- include('partials/header', { title: 'Ersteinrichtung' }) %>

<div class="security-step" style="margin: 1.5rem auto 0; max-width: 560px">
  <div class="security-step-body" style="padding-top: 1.4rem">
    <div class="stepper">
      <div class="stepper-step">
        <span class="stepper-dot <%= step === 1 ? 'is-current' : 'is-done' %>">
          <% if (step === 1) { %>1<% } else { %><%- include('partials/icon', { name: 'file-check' }) %><% } %>
        </span>
        <span class="stepper-label <%= step === 1 ? '' : 'is-pending' %>">Admin-Zugang</span>
      </div>
      <div class="stepper-line"></div>
      <div class="stepper-step">
        <span class="stepper-dot <%= step === 2 ? 'is-current' : 'is-pending' %>">2</span>
        <span class="stepper-label <%= step === 2 ? '' : 'is-pending' %>">Certificate Authority</span>
      </div>
    </div>

    <% if (step === 1) { %>
      <h1>Admin-Zugang anlegen</h1>
      <p class="hint" style="margin-bottom:1.2rem">Ein Konto, ein Passwort – das ist die gesamte Nutzerverwaltung dieser App.</p>
      <% if (error) { %>
        <div class="alert alert-error"><%- include('partials/icon', { name: 'alert-circle' }) %><span><%= error %></span></div>
      <% } %>
      <form method="POST" action="/setup/admin">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Benutzername
          <input type="text" name="username" required autofocus>
        </label>
        <label>Passwort
          <input type="password" name="password" required minlength="12">
        </label>
        <label>Passwort bestätigen
          <input type="password" name="confirmPassword" required minlength="12">
        </label>
        <div class="context-hint">
          <%- include('partials/icon', { name: 'key-round' }) %>
          <span>Dieses Passwort ist gleichzeitig Login und Schlüssel: daraus wird per Argon2id der Schlüssel abgeleitet, der CA- und Zertifikatsschlüssel verschlüsselt. Es gibt kein zweites Master-Passwort und keine Wiederherstellung. Mindestens 12 Zeichen.</span>
        </div>
        <button type="submit">Weiter<%- include('partials/icon', { name: 'arrow-right' }) %></button>
      </form>
    <% } else { %>
      <h1>Certificate Authority erzeugen</h1>
      <p class="hint" style="margin-bottom:1.2rem">Letzter Schritt: die CA, die alle Client-Zertifikate signiert.</p>
      <% if (error) { %>
        <div class="alert alert-error"><%- include('partials/icon', { name: 'alert-circle' }) %><span><%= error %></span></div>
      <% } %>
      <form method="POST" action="/setup/ca">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Organisationsname (im CA-Zertifikat)
          <input type="text" name="orgName" placeholder="mTLS Certificate Manager">
        </label>
        <label>Admin-Passwort (aus Schritt 1)
          <input type="password" name="password" required autofocus>
        </label>
        <div class="context-hint" style="flex-direction:column;gap:0.5rem">
          <div style="display:flex;gap:0.55rem;align-items:flex-start">
            <%- include('partials/icon', { name: 'file-check' }) %>
            <span><span class="mono" style="color:var(--text)">ca.crt</span> unverschlüsselt – zur Verteilung, z. B. an Nginx Proxy Manager</span>
          </div>
          <div style="display:flex;gap:0.55rem;align-items:flex-start">
            <%- include('partials/icon', { name: 'lock' }) %>
            <span><span class="mono" style="color:var(--text)">ca.key</span> AES-256-GCM-verschlüsselt gespeichert</span>
          </div>
          <div style="display:flex;gap:0.55rem;align-items:flex-start">
            <%- include('partials/icon', { name: 'hourglass' }) %>
            <span>RSA-4096 – die Erzeugung kann einige Sekunden dauern</span>
          </div>
        </div>
        <button type="submit"><%- include('partials/icon', { name: 'landmark' }) %>CA erzeugen</button>
      </form>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
